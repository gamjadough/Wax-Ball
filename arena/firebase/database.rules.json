{
  "rules": {
    ".read": false,
    ".write": false,
    "arena": {
      "users": {
        "$uid": {
          "matches": {
            ".read": "auth != null && auth.uid === $uid && auth.token.email_verified === true",
            "$matchId": {
              ".write": "auth != null && auth.uid === $uid && auth.token.email_verified === true && !data.exists() && newData.exists()",
              ".validate": "$matchId.matches(/^[a-f0-9-]{36}$/) && newData.hasChildren(['id', 'result', 'difficulty', 'durationMs', 'completedAt'])",
              "id": { ".validate": "newData.isString() && newData.val() === $matchId" },
              "result": { ".validate": "newData.val() === 'victory' || newData.val() === 'defeat'" },
              "difficulty": { ".validate": "newData.val() === 'entry' || newData.val() === 'beginner' || newData.val() === 'intermediate' || newData.val() === 'advanced'" },
              "durationMs": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 86400000 && newData.val() % 1 === 0" },
              "completedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    }
  }
}
